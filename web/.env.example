# Copia a .env solo si necesitas cambiar algo. En el VPS no hace falta:
# la web y la API comparten dominio (Caddy envía /api a la API).

# true = usa datos de ejemplo sin API (para diseñar o para un ensayo sin servidor).
# Si no se define, la web intenta la API y, si no responde, pasa a datos de ejemplo.
VITE_MODO_DEMO=
# Ruta base de la API. Por defecto /api (mismo dominio).
VITE_API_URL=/api
