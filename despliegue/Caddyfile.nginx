# VPS compartido: el nginx del servidor tiene los puertos 80/443 y el HTTPS (certbot).
# Caddy solo escucha HTTP en 127.0.0.1:8088 y reparte a web, api y bot.
# Se activa con CADDYFILE=Caddyfile.nginx en .env y docker-compose.override.yml (ver docs/instalar_vps.md).
{
	servers {
		# Confiar en el X-Forwarded-For del nginx del servidor: así la API ve la IP real
		# de cada visitante (límites por IP y bloqueo por fuerza bruta).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 15MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# IP real del visitante para límites, bloqueo de login y auditoría.
			header_up X-Real-IP {client_ip}
		}
	}
	handle /bot/* {
		reverse_proxy bot:8080
	}
	# App móvil: el APK y su app.json viven en despliegue/descargas (fuera de git). Ver scripts/publicar_apk.sh.
	handle /descargas/* {
		root * /srv
		header *.apk Content-Type application/vnd.android.package-archive
		header *.json Cache-Control no-cache
		file_server
	}
	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
