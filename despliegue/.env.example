# Copiar a .env (lo hace ./fitolens.sh instalar). Es el ÚNICO archivo de configuración.

# ---- Dirección pública ----
# Con dominio: fitolens.tudominio.pe   |   Sin dominio: 203.0.113.10.sslip.io (tu IP + .sslip.io)
DOMINIO=fitolens.5-253-232-122.sslip.io
ACME_EMAIL=CAMBIAR@correo.com

# ---- Base de datos ----
POSTGRES_USER=fitolens
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DB=fitolens

# ---- API ----
JWT_SECRETO=__GENERAR__
ADMIN_USUARIO=CAMBIAR@correo.com
ADMIN_CLAVE=__GENERAR__
# Procesos de la API (cada uno carga los modelos en RAM)
API_WORKERS=2

# ---- Alertas de brote ----
# Alerta cuando una provincia junta este número de casos de la misma enfermedad dentro de la ventana (días).
# Los técnicos se suscriben escribiendo /alertas al bot; el bot usa JWT_SECRETO para hablar con la API.
ALERTA_UMBRAL_CASOS=3
ALERTA_VENTANA_DIAS=7

# ---- Bot de Telegram (opcional) ----
TELEGRAM_TOKEN=
# polling: el bot pide los mensajes a Telegram; no depende de nginx ni del HTTPS (lo más seguro en la feria).
BOT_MODO=polling
# Para activar el bot: COMPOSE_PROFILES=online,bot
COMPOSE_PROFILES=online

# ---- Web ----
# false = si la API falla, la web muestra el error (nunca resultados simulados). Vacío = modo demo automático.
VITE_MODO_DEMO=false

# ---- Imágenes y modelos ----
REGISTRO=ghcr.io/sorprendete
VERSION=latest
# Release de GitHub del que se bajan los modelos (ver docs/mantenimiento.md)
MODELOS_VERSION=modelos-v1

# ---- Respaldos ----
RESPALDO_DIAS=14
RESPALDO_HORA=03
TZ=America/Lima

# ---- VPS compartido con nginx (ver docs/instalar_vps.md) ----
# Caddy queda en 127.0.0.1:8088 detrás del nginx del servidor. Bórrala si FitoLens tiene el VPS solo.
CADDYFILE=Caddyfile.nginx
