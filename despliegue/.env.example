# Copiar a .env (lo hace ./fitolens.sh instalar). Es el ÚNICO archivo de configuración.

# ---- Dirección pública ----
# Con dominio: fitolens.tudominio.pe   |   Sin dominio: 203.0.113.10.sslip.io (tu IP + .sslip.io)
DOMINIO=5.253.232.122.sslip.io
ACME_EMAIL=CAMBIAR@correo.com

# ---- Base de datos ----
POSTGRES_USER=fitolens
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DB=fitolens

# ---- API ----
JWT_SECRETO=__GENERAR__
ADMIN_USUARIO=CAMBIAR@correo.com
ADMIN_CLAVE=__GENERAR__
# Procesos de la API (cada uno carga los modelos en RAM)
API_WORKERS=2

# ---- Bot de Telegram (opcional) ----
TELEGRAM_TOKEN=
# Para activar el bot: COMPOSE_PROFILES=online,bot
COMPOSE_PROFILES=online

# ---- Imágenes y modelos ----
REGISTRO=ghcr.io/sorprendete
VERSION=latest
# Release de GitHub del que se bajan los modelos (ver docs/mantenimiento.md)
MODELOS_VERSION=modelos-v1

# ---- Respaldos ----
RESPALDO_DIAS=14
RESPALDO_HORA=03
TZ=America/Lima
