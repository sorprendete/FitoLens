# VPS: HTTPS automático (Let's Encrypt) para el DOMINIO de .env
{
	email {$ACME_EMAIL}
}

{$DOMINIO} {
	encode zstd gzip
	request_body {
		max_size 15MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# IP real del visitante para límites, bloqueo de login y auditoría.
			header_up X-Real-IP {client_ip}
		}
	}
	handle /bot/* {
		reverse_proxy bot:8080
	}
	# App móvil: el APK y su app.json viven en despliegue/descargas (fuera de git). Ver scripts/publicar_apk.sh.
	handle /descargas/* {
		root * /srv
		header *.apk Content-Type application/vnd.android.package-archive
		header *.json Cache-Control no-cache
		file_server
	}
	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
